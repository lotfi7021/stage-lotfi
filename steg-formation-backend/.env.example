# Serveur
PORT=5000
NODE_ENV=development

# Base de données MySQL/MariaDB (utilisée par Prisma)
DATABASE_URL="mysql://root:@localhost:3306/steg_formation"

# JWT
JWT_SECRET=change_this_secret_en_production_avec_une_valeur_longue_et_aleatoire
JWT_EXPIRES_IN=8h

# CORS - URL du frontend React
CLIENT_URL=http://localhost:5173

# Swagger (désactivé en production sauf true)
ENABLE_SWAGGER=false

# Admin initial créé par le seed (obligatoire pour prisma/seed.js)
ADMIN_EMAIL=admin@steg.tn
ADMIN_PASSWORD=123456
ADMIN_MATRICULE=ADM-0001
